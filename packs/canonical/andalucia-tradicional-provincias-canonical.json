_vinagre","qty":8,"unit":"ml"}],"packId":"pack_andalucia_tradicional","normalizedToServing":true,"originalServings":1,"schemaVersion":1},{"id":"dish_and_02_salmorejo","name":"Salmorejo cordobés con huevo y jamón","servings":1,"unit":"ración","category":"Sopa fría","tags":["Andalucía","Córdoba","clásico"],"prepTime":"20 min","difficulty":"fácil","notes":"El pan marca la textura final.","instructions":["Tritura tomate, ajo y sal hasta obtener puré.","Añade el pan y deja hidratar cinco minutos.","Vuelve a triturar incorporando el aceite poco a poco.","Cuece el huevo, enfría y pica.","Sirve el salmorejo frío.","Termina con huevo y jamón por encima."],"recipe":[{"ingredientId":"ingredient_tomate","qty":320,"unit":"g"},{"ingredientId":"ingredient_pan","qty":45,"unit":"g"},{"ingredientId":"ingredient_ajo","qty":2,"unit":"g"},{"ingredientId":"ingredient_aceite","qty":18,"unit":"ml"},{"ingredientId":"ingredient_huevo","qty":1,"unit":"unidades"},{"ingredientId":"ingredient_jamon","qty":15,"unit":"g"}],"packId":"pack_andalucia_tradicional","normalizedToServing":true,"originalServings":1,"schemaVersion":1},{"id":"dish_and_03_ajoblanco","name":"Ajoblanco malagueño con uvas","servings":1,"unit":"ración","category":"Sopa fría","tags":["Andalucía","Málaga / Granada","almendra","frío"],"prepTime":"15 min + reposo","difficulty":"fácil","notes":"Sopa fría tradicional de almendra.","instructions":["Remoja el pan en agua fría.","Tritura almendras, ajo y sal hasta formar pasta.","Añade el pan escurrido y bate.","Incorpora agua fría hasta lograr textura de sopa.","Emulsiona con aceite y ajusta con vinagre.","Enfría y sirve con uvas."],"recipe":[{"ingredientId":"ingredient_almendra","qty":45,"unit":"g"},{"ingredientId":"ingredient_pan","qty":35,"unit":"g"},{"ingredientId":"ingredient_ajo","qty":1,"unit":"g"},{"ingredientId":"ingredient_aceite","qty":18,"unit":"ml"},{"ingredientId":"ingredient_vinagre","qty":6,"unit":"ml"},{"ingredientId":"ingredient_uvas","qty":80,"unit":"g"}],"packId":"pa
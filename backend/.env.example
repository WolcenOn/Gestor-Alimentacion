# Backend Railway/local configuration. Do not commit real secrets.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/gestor_alimentacion?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
USDA_API_KEY=

# Optional release metadata for /health and /api/v1/version.
# Railway provides RAILWAY_GIT_COMMIT_SHA automatically in deployments.
RELEASE_COMMIT=local
BUILD_TIME=unknown

# Backend Railway/local configuration. Do not commit real secrets.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/gestor_alimentacion?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
USDA_API_KEY=

# Password recovery email. Leave SMTP_HOST/SMTP_FROM/PASSWORD_RESET_URL empty
# to keep recovery disabled without affecting login, registration or sync.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:5173/
